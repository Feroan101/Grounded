# =============================================================================
# Grounded Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# Never commit .env or any real credentials.

# Firebase Project ID (public, used for token verification)
FIREBASE_PROJECT_ID=grounded-coffeeshop-ai

# -----------------------------------------------------------------------------
# Application environment
# -----------------------------------------------------------------------------
# "development" | "production"
# In production, development-only fallbacks are never used.
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Google Cloud Credentials (needed for Firestore access)
# -----------------------------------------------------------------------------
#
# Token verification does NOT require credentials.
# It uses Google's public JWKS keys.
#
# Credentials are ONLY needed for Firestore and other Admin SDK operations.
#
# LOCAL DEVELOPMENT (recommended):
#   1. Install gcloud CLI: https://cloud.google.com/sdk/docs/install
#   2. Run: gcloud auth application-default login
#   3. This sets GOOGLE_APPLICATION_CREDENTIALS automatically
#
# ALTERNATIVE (if you have a service-account JSON):
#   FIREBASE_CREDENTIALS_PATH=/home/you/.grounded/firebase-service-account.json
#
# RENDER DEPLOYMENT:
#   The Render authentication/credential mechanism is decided later.
#   Options under evaluation: an external secrets provider or a mounted
#   credential file. The backend reads GOOGLE_APPLICATION_CREDENTIALS /
#   FIREBASE_CREDENTIALS_PATH when present.

FIREBASE_CREDENTIALS_PATH=

# CORS allowed origins (comma-separated). REQUIRED — there is NO code fallback.
# If unset or empty, cross-origin browser requests are denied (default-deny).
# Set the browser origin(s) for each environment:
#   Local:     http://localhost:3000
#   Production: your deployed frontend URL
ALLOWED_ORIGINS=http://localhost:3000,https://grounded-coffeeshop-ai.web.app

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# Render injects PORT automatically; the backend prefers it over API_PORT.
API_HOST=0.0.0.0
API_PORT=8000

# -----------------------------------------------------------------------------
# AI / LLM
# -----------------------------------------------------------------------------
# Provider must be one of the supported enum values (gemini for now).
LLM_PROVIDER=gemini

# Gemini model used by the assistant.
LLM_MODEL=gemini-3.1-flash-lite

# Gemini API key — NEVER commit a real key.
# Local development: put your key in backend/.env (GEMINI_API_KEY=...).
# GOOGLE_API_KEY is also accepted as a fallback by the config system.
GEMINI_API_KEY=

LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.4

# -----------------------------------------------------------------------------
# RAG / Knowledge base
# -----------------------------------------------------------------------------
# Semantic menu retrieval provider. Qdrant Cloud is the locked-in vector store.
VECTOR_STORE_PROVIDER=qdrant_cloud

# Gemini embedding model used for semantic menu retrieval.
# gemini-embedding-001 is the current stable text embedding model.
# The embedding calls reuse the same GEMINI_API_KEY credential as the chat.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Qdrant Cloud connection — NEVER commit real credentials.
# Copy your Qdrant Cloud URL and API key into backend/.env (QDRANT_URL, QDRANT_API_KEY).
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=grounded-menu

# How many semantic candidates to fetch before applying hard structured filters.
MENU_SEMANTIC_TOP_K=20

# Hierarchical chunking tuning (starting ranges, tunable without code changes).
PARENT_CHUNK_TOKENS_MIN=600
PARENT_CHUNK_TOKENS_MAX=1200
CHILD_CHUNK_TOKENS_MIN=150
CHILD_CHUNK_TOKENS_MAX=300

# Retrieval tuning
RETRIEVAL_TOP_K=4
RETRIEVAL_ENABLE_HYBRID=false
RETRIEVAL_ENABLE_RERANK=false