# =============================================================================
# Grounded Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# Never commit .env or any real credentials.

# Firebase Project ID (public, used for token verification)
FIREBASE_PROJECT_ID=grounded-coffeeshop-ai

# -----------------------------------------------------------------------------
# Google Cloud Credentials (needed for Firestore access)
# -----------------------------------------------------------------------------
#
# Token verification does NOT require credentials.
# It uses Google's public JWKS keys.
#
# Credentials are ONLY needed for Firestore and other Admin SDK operations.
#
# LOCAL DEVELOPMENT (recommended):
#   1. Install gcloud CLI: https://cloud.google.com/sdk/docs/install
#   2. Run: gcloud auth application-default login
#   3. This sets GOOGLE_APPLICATION_CREDENTIALS automatically
#
# ALTERNATIVE (if you have a service-account JSON):
#   FIREBASE_CREDENTIALS_PATH=/home/you/.grounded/firebase-service-account.json
#
# RENDER DEPLOYMENT:
#   Configure Workload Identity Federation when ready.
#   See: docs/RENDER_WIF.md (to be created)

FIREBASE_CREDENTIALS_PATH=

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000

# Server
API_HOST=0.0.0.0
API_PORT=8000
