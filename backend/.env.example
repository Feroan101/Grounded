# =============================================================================
# Grounded Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# Never commit .env or any real credentials.

# Firebase Project ID (public, used for token verification)
FIREBASE_PROJECT_ID=grounded-coffeeshop-ai

# -----------------------------------------------------------------------------
# Firebase Admin Credentials — OPTIONAL
# -----------------------------------------------------------------------------
#
# Token verification does NOT require credentials.
# It uses Google's public JWKS keys (https://www.googleapis.com/robot/v1/metadata/x509/securetoken@system.gserviceaccount.com).
#
# Credentials are ONLY needed when you add Firestore access or other Admin SDK operations.
#
# LOCAL DEVELOPMENT (when Firestore is needed):
#   Set GOOGLE_APPLICATION_CREDENTIALS to your ADC file:
#     gcloud auth application-default login
#     GOOGLE_APPLICATION_CREDENTIALS=~/.config/gcloud/application_default_credentials.json
#   Or point to a service-account JSON (if you have one):
#     FIREBASE_CREDENTIALS_PATH=/home/you/.grounded/firebase-service-account.json
#
# RENDER (when Firestore is needed):
#   Option A — Mounted Secret File:
#     Upload service-account JSON as a Render Secret File.
#     Set: FIREBASE_CREDENTIALS_PATH=/etc/secrets/firebase-service-account.json
#   Option B — GOOGLE_APPLICATION_CREDENTIALS:
#     Set: GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/service-account.json
#
# NOTE: If your organization blocks service-account key creation,
# use Workload Identity Federation for Render instead of a JSON key.
# See: https://cloud.google.com/iam/docs/workload-identity-federation

FIREBASE_CREDENTIALS_PATH=

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000

# Server
API_HOST=0.0.0.0
API_PORT=8000
